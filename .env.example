# ---------- Backend (FastAPI) ----------
# PostgreSQL in production; SQLite file is used when unset (local dev)
DATABASE_URL=postgresql+psycopg://mediscan:mediscan@localhost:5432/mediscan
# Fernet key for encryption at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDISCAN_ENCRYPTION_KEY=
# Comma-separated list of allowed browser origins (your Vercel URL)
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Optional shared secret; when set every /api route requires header X-API-Key
MEDISCAN_API_KEY=
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=10
MAINS_HZ=50
ENFORCE_HTTPS=false
MEDISCAN_STORAGE_DIR=./backend/storage

# ---------- Frontend (Next.js, set in Vercel project settings) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=
